# AutoShorts — SECRETS ONLY
# =========================
# Copy to `.env` and fill in. Operational settings (models, temperatures, retry,
# timeouts, TTS defaults) do NOT belong here — they live in
# src/agents/core/config.py under APP_CONFIG.

# --- Required ---
TAVILY_API_KEY=tvly-...

# LLM provider. OpenAI is the default for every route.
OPENAI_API_KEY=

# --- Optional ---
# Gemini is the SECONDARY provider, kept for A/B comparison and rollback:
#   python -m src.cli.autoshorts run ... --llm-provider gemini
# Only needed if you actually run that arm.
# GEMINI_API_KEY=AIza...

# ElevenLabs TTS (Phase 3). Not needed in offline mode.
# ELEVENLABS_API_KEY=...

# NOTE: GEMINI_MODEL / GEMINI_RPM_LIMIT / GEMINI_TEMPERATURE / API_TIMEOUT_SECONDS
# are IGNORED. Edit LLMConfig in src/agents/core/config.py instead.
