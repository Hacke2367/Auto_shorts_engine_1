{
  "job_id": "test_geo_universal_n5",
  "template_id": "geo_universal",
  "data_csv": "data/map_data.csv",
  "video": { "w": 1080, "h": 1920 },

  "audio": {
    "segments": [
      { "name": "hook",   "path": "audio/hook.mp3" },
      { "name": "setup",  "path": "audio/setup.mp3" },
      { "name": "node_1", "path": "audio/node_1.mp3" },
      { "name": "node_2", "path": "audio/node_2.mp3" },
      { "name": "node_3", "path": "audio/node_3.mp3" },
      { "name": "node_4", "path": "audio/node_4.mp3" },
      { "name": "node_5", "path": "audio/node_5.mp3" },
      { "name": "winner", "path": "audio/winner.mp3" },
      { "name": "outro",  "path": "audio/outro.mp3" }
    ],
    "order": ["hook", "setup", "node_1", "node_2", "node_3", "node_4", "node_5", "winner", "outro"]
  },

  "timeline": {
    "hook":   3.84,
    "setup":  3.21,
    "node_1": 2.50,
    "node_2": 2.63,
    "node_3": 2.52,
    "node_4": 2.50,
    "node_5": 2.54,
    "winner": 2.81,
    "outro":  2.20
  },

  "gains":  { "gain_voice": 1.0, "gain_sfx": 1.0, "gain_bgm_db": -20.0 },
  "sfx":    { "enabled": true, "gain": 1.0 },
  "bgm": {
    "enabled": false,
    "mode": "per_segment",
    "library_dir": "audio/bgm",
    "default": { "path": "bgm_default.mp3", "gain_db": 0.0, "duck": true, "duck_amount": "strong" },
    "segments": {},
    "crossfade": 0.25
  },
  "mix": { "preset": "punchy", "duck_sfx": false },
  "captions": {
    "enabled": true,
    "script": { "path": "script/script.json", "source_lang": "hi", "target_langs": ["en"] },
    "render": {
      "format": "ass",
      "burn_in": true,
      "style": { "preset": "modern_premium", "safe_margin_px": 80, "max_lines": 2 },
      "tracks": [
        { "lang": "hi", "mode": "reveal_words", "position": "bottom" },
        { "lang": "en", "mode": "plain", "position": "above_bottom" }
      ],
      "highlight": { "enabled": false, "mode": "word_reveal" }
    }
  },
  "output": {
    "final_mp4": "output/final.mp4",
    "subtitles_ass": "output/subtitles.ass",
    "final_captioned_mp4": "output/final_captioned.mp4"
  }
}
